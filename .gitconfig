[init]
	defaultBranch = main

[alias]
	c = commit -am
	up = pull
	p = push
	s = status
	uc = reset --soft HEAD~1
	df = diff --color --color-words --abbrev
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	co = checkout
	fix = "!f() { git commit --fixup ${1}; git rebase -i ${1}~; }; f"

	# Is it a `main` or a `master` repo? Requires origin/HEAD to be set
	# (git remote set-head origin -a), which a plain `git clone` sets up.
	mainormaster = !"git rev-parse --abbrev-ref origin/HEAD | sed 's|^origin/||'"

	# Show the diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

[color]
	ui = auto

[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
	editor = nano
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[merge]
	conflictStyle = zdiff3

# rewrites
[url "git@github.com:"]
	insteadOf = "gh:"
	insteadOf = "git://github.com"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"
    pushInsteadOf = "https://github.com/"
[url "git@gist.github.com:"]
	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"
	pushInsteadOf = "https://gist.github.com/"


# Any GitHub repo with my username should be checked out r/w by default
# http://rentzsch.tumblr.com/post/564806957/public-but-hackable-git-submodules

#[url "git@github.com:paulirish/"]
#  insteadOf = "git://github.com/paulirish/"
[help]
	autocorrect = 1

# push easily. http://stackoverflow.com/a/23918418/89484
[push]
	default = current
	autoSetupRemote = true



[include]
  # For username / github token / etc
  path = ~/.gitconfig.local
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[checkout]
	workers = 0
